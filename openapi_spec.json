{
  "openapi": "3.1.0",
  "info": {
    "title": "EvoFold Discovery Agent API",
    "version": "2.1.0",
    "description": "Deterministic, unvalidated screening heuristics and system task classification"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Static screening demonstration",
        "responses": {
          "200": {
            "description": "HTML interface"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "responses": {
          "200": {
            "description": "JSON status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory JSON counters",
        "responses": {
          "200": {
            "description": "JSON metrics"
          }
        }
      }
    },
    "/api/screen": {
      "post": {
        "summary": "Screen molecular descriptors",
        "responses": {
          "200": {
            "description": "Heuristic dossier"
          },
          "422": {
            "description": "Invalid inputs"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Classify system task",
        "responses": {
          "200": {
            "description": "Rule-based system dossier"
          },
          "422": {
            "description": "Invalid inputs"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Local mock chat",
        "responses": {
          "200": {
            "description": "Mock output"
          },
          "400": {
            "description": "Blocked input"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "In-memory audit chain",
        "responses": {
          "200": {
            "description": "Audit ledger and integrity"
          }
        }
      }
    }
  }
}
